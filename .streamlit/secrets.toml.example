# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Use the "Transaction Mode" pooler URL from:
#   Supabase Dashboard -> Settings -> Database -> Connection pooling
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ── Azure AD (for Outlook email import — optional) ───────────────────────────
AZURE_CLIENT_ID = "19283e00-a7fa-4b0c-910c-5b9a85b8e990"
AZURE_TENANT_ID = "4a4f2e28-2f12-4cdb-b5eb-9860e3af1045"
